# Required: clients send this as "Authorization: Bearer <token>". Generate with: openssl rand -hex 32
MCP_API_TOKEN=

# Optional (deployed): override the Chromium pack URL. Must match the @sparticuz/chromium-min version.
# CHROMIUM_PACK_URL=https://github.com/Sparticuz/chromium/releases/download/v153.0.0/chromium-v153.0.0-pack.x64.tar

# Optional (local): path to a Chromium binary, instead of `npx playwright install chromium`.
# CHROMIUM_EXECUTABLE_PATH=

# Optional (local): extra Chromium flags, space separated, e.g. --proxy-server=http://127.0.0.1:8080
# CHROMIUM_EXTRA_ARGS=
